# ── Supabase (Project Settings → API) ──
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...   # service_role kaliti (MAXFIY! faqat serverda)

# ── Admin login/parol (admin panelga kirish uchun) ──
ADMIN_LOGIN=admin
ADMIN_PASSWORD=kuchli-parol-yozing

# ── Sessiya cookie'larini imzolash uchun tasodifiy uzun satr ──
# Yaratish: openssl rand -hex 32
AUTH_SECRET=change-me-to-a-long-random-string

# ── Telegram bot ──
# Bot tokeni endi admin saytdagi "Bot nazorati" bo'limida kiritiladi.
# Quyidagilar ixtiyoriy (zaxira variant, admin saytda kiritilgani ustun turadi):
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_WEBHOOK_SECRET=
# NEXT_PUBLIC_APP_URL=https://xizmatchi.netlify.app

# Brauzerda (Telegram'siz) mini appni sinash uchun: true. Productionda false qiling!
ALLOW_DEV_USER=false
